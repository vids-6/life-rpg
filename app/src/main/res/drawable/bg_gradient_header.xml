<?xml version="1.0" encoding="utf-8"?>
<!-- Hero surface: forest (dark) / rose clay (light) with a hairline of gold. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="@color/lr_hero_mid"
        android:endColor="@color/lr_hero_end"
        android:startColor="@color/lr_hero_start" />
    <stroke android:width="1dp" android:color="#59F2C14E" />
    <corners android:radius="28dp" />
</shape>
