<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
           >

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.LifeRPG.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deep work" />

                <TextView
                    style="@style/Text.LifeRPG.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Focus Mode" />

                <TextView
                    style="@style/Text.LifeRPG.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Stay focused. Earn XP." />
            </LinearLayout>

            <com.example.liferpg.ui.AvatarView
                android:id="@+id/avatar_mini"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:contentDescription="Your avatar. Tap to customize." />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_15"
                style="@style/Widget.LifeRPG.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 min" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_25"
                style="@style/Widget.LifeRPG.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="25 min" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_45"
                style="@style/Widget.LifeRPG.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45 min" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_60"
                style="@style/Widget.LifeRPG.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="60 min" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Timer: a 280dp square; ring, disc and digits are all centred in it -->
        <FrameLayout
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="28dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="14dp"
                android:background="@drawable/bg_circle_surface" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_circle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="1000"
                app:indicatorColor="@color/lr_primary"
                app:indicatorSize="268dp"
                app:trackColor="@color/lr_surface_high"
                app:trackCornerRadius="8dp"
                app:trackThickness="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="36dp">

                <TextView
                    android:id="@+id/tv_timer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="68sp"
                    android:autoSizeMinTextSize="36sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/lr_text" />

                <TextView
                    android:id="@+id/tv_state"
                    style="@style/Text.LifeRPG.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/lr_gold_text"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start"
                style="@style/Widget.LifeRPG.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="2"
                android:text="Start"
                app:icon="@drawable/ic_play" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset"
                style="@style/Widget.LifeRPG.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Reset"
                app:icon="@drawable/ic_replay" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.LifeRPG.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_tile"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_bulb"
                    app:tint="@color/lr_attr_intelligence" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_sessions_today"
                        style="@style/Text.LifeRPG.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tv_sessions_total"
                        style="@style/Text.LifeRPG.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tv_reward_hint"
                        style="@style/Text.LifeRPG.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/lr_gold_text" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
