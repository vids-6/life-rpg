<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lr_bg"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp">

        <ImageButton
            android:id="@+id/ib_back"
            style="@style/Widget.LifeRPG.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.LifeRPG.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Train in the real world" />

            <TextView
                style="@style/Text.LifeRPG.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gym Finder" />
        </LinearLayout>
    </LinearLayout>

    <!-- Discover / Saved -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/lr_gold"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabRippleColor="@color/lr_primary_soft"
        app:tabSelectedTextColor="@color/lr_gold_text"
        app:tabTextAppearance="@style/TextAppearance.LifeRPG.Tab"
        app:tabTextColor="@color/lr_text_secondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/bg_divider" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <!-- Discover controls -->
            <LinearLayout
                android:id="@+id/panel_discover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_search"
                        style="@style/Widget.LifeRPG.Input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Gym name"
                        app:endIconMode="clear_text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_search"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:minHeight="56dp"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_search"
                        style="@style/Widget.LifeRPG.Button"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="10dp"
                        android:contentDescription="Search gyms"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_search"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="26dp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cg_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="20dp"
                        app:chipSpacingHorizontal="8dp"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_mode_name"
                            style="@style/Widget.LifeRPG.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Search by gym name" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_mode_location"
                            style="@style/Widget.LifeRPG.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Search an area" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_near_me"
                    style="@style/Widget.LifeRPG.Button.Gold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="12dp"
                    android:text="Find gyms near me"
                    app:icon="@drawable/ic_my_location"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="22dp" />

                <TextView
                    style="@style/Text.LifeRPG.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="16dp"
                    android:text="Search radius" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cg_radius"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="20dp"
                        app:chipSpacingHorizontal="8dp"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_r1"
                            style="@style/Widget.LifeRPG.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="1000"
                            android:text="1 km" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_r2"
                            style="@style/Widget.LifeRPG.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:tag="2000"
                            android:text="2 km" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_r5"
                            style="@style/Widget.LifeRPG.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="5000"
                            android:text="5 km" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_r10"
                            style="@style/Widget.LifeRPG.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="10000"
                            android:text="10 km" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Optional Google map (only when a Maps key is configured) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_map"
                style="@style/Widget.LifeRPG.Card"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp">

                <com.example.liferpg.ui.NestedMapContainer
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.google.android.gms.maps.MapView
                        android:id="@+id/map_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </com.example.liferpg.ui.NestedMapContainer>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/pb_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/lr_primary"
                app:trackColor="@color/lr_surface_high"
                app:trackCornerRadius="4dp"
                app:trackThickness="6dp" />

            <TextView
                android:id="@+id/tv_results_header"
                style="@style/Text.LifeRPG.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

            <!-- Empty / error / permission / intro state -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_state"
                style="@style/Widget.LifeRPG.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:id="@+id/iv_state"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_circle"
                        android:contentDescription="@null"
                        android:padding="20dp"
                        app:tint="@color/lr_primary_text" />

                    <TextView
                        android:id="@+id/tv_state_title"
                        style="@style/Text.LifeRPG.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tv_state_msg"
                        style="@style/Text.LifeRPG.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/lr_text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_state_primary"
                        style="@style/Widget.LifeRPG.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_state_secondary"
                        style="@style/Widget.LifeRPG.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_gyms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingHorizontal="20dp"
                android:paddingTop="6dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
