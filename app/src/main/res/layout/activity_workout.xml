<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lr_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/ib_back"
                style="@style/Widget.LifeRPG.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Back"
                android:src="@drawable/ic_back" />

            <TextView
                style="@style/Text.LifeRPG.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Workout" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_setup"
            style="@style/Widget.LifeRPG.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.LifeRPG.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Gym">

                    <AutoCompleteTextView
                        android:id="@+id/act_gym"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_custom_gym"
                    style="@style/Widget.LifeRPG.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Gym name"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_custom_gym"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLength="60"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Text.LifeRPG.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Workout type" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cg_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_strength"
                        style="@style/Widget.LifeRPG.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Strength Training"
                        app:chipIcon="@drawable/ic_gym"
                        app:chipIconVisible="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cardio"
                        style="@style/Widget.LifeRPG.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cardio"
                        app:chipIcon="@drawable/ic_pulse"
                        app:chipIconVisible="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_general"
                        style="@style/Widget.LifeRPG.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="General Fitness"
                        app:chipIcon="@drawable/ic_bolt"
                        app:chipIconVisible="true" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_gradient_header"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_light"
                    android:contentDescription="@null"
                    android:padding="9dp"
                    android:src="@drawable/ic_gym"
                    app:tint="@color/lr_gold_light" />

                <TextView
                    android:id="@+id/tv_elapsed"
                    style="@style/Text.LifeRPG.OnGradient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="00:00:00"
                    android:autoSizeMaxTextSize="46sp"
                    android:autoSizeMinTextSize="28sp"
                    android:autoSizeTextType="uniform"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tv_workout_info"
                    style="@style/Text.LifeRPG.OnGradient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:gravity="center"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_xp_preview"
                    style="@style/Text.LifeRPG.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/lr_gold_light" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_workout"
            style="@style/Widget.LifeRPG.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Start workout"
            app:icon="@drawable/ic_play" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_finish_workout"
            style="@style/Widget.LifeRPG.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Finish &amp; confirm workout"
            android:visibility="gone"
            app:backgroundTint="@color/lr_success"
            app:icon="@drawable/ic_check"
            app:iconTint="@color/lr_on_gold"
            android:textColor="@color/lr_on_gold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_workout"
            style="@style/Widget.LifeRPG.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cancel workout"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_workout_hint"
            style="@style/Text.LifeRPG.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />
    </LinearLayout>
</ScrollView>
