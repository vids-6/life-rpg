<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lr_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Step 1: welcome + RPG intro -->
            <LinearLayout
                android:id="@+id/step_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_gradient_header"
                    android:paddingVertical="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="132dp"
                            android:layout_height="132dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_launcher_foreground" />

                        <TextView
                            style="@style/Text.LifeRPG.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LIFE RPG"
                            android:textColor="@color/lr_white" />

                        <TextView
                            style="@style/Text.LifeRPG.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Turn your real life into an adventure."
                            android:textColor="#CCFFFFFF" />
                    </LinearLayout>
                </FrameLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.LifeRPG.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            style="@style/Text.LifeRPG.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="How it works" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tile"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_quests"
                        app:tint="@color/lr_attr_strength" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.LifeRPG.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Complete quests" />

                        <TextView
                            style="@style/Text.LifeRPG.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Study, fitness, health and more earn you XP." />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tile"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_timer"
                        app:tint="@color/lr_attr_intelligence" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.LifeRPG.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Enter focus mode" />

                        <TextView
                            style="@style/Text.LifeRPG.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Finish a timer to earn XP and grow Intelligence." />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tile"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_gym"
                        app:tint="@color/lr_attr_vitality" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.LifeRPG.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Train for real" />

                        <TextView
                            style="@style/Text.LifeRPG.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Find a gym, work out and confirm it for XP." />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tile"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_stats"
                        app:tint="@color/lr_attr_discipline" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.LifeRPG.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Level up" />

                        <TextView
                            style="@style/Text.LifeRPG.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Grow five attributes and keep your daily streak alive." />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tile"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_trophy"
                        app:tint="@color/lr_gold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.LifeRPG.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unlock badges" />

                        <TextView
                            style="@style/Text.LifeRPG.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Collect achievements as your hero grows." />
                    </LinearLayout>
                </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Step 2: create hero -->
            <LinearLayout
                android:id="@+id/step_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    style="@style/Text.LifeRPG.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Step 2 of 2" />

                <TextView
                    style="@style/Text.LifeRPG.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create your hero" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_gradient_header"
                    android:paddingVertical="24dp">

                    <com.example.liferpg.ui.AvatarView
                        android:id="@+id/avatar_view"
                        android:layout_width="156dp"
                        android:layout_height="156dp"
                        android:layout_gravity="center_horizontal"
                        android:contentDescription="Your avatar. Tap to customize." />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_customize"
                    style="@style/Widget.LifeRPG.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Customize your hero"
                    app:icon="@drawable/ic_sparkle" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_name"
                    style="@style/Widget.LifeRPG.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="Hero name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="24"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.LifeRPG.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="Back"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next"
            style="@style/Widget.LifeRPG.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Next" />
    </LinearLayout>
</LinearLayout>
