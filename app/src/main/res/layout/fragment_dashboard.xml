<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/root_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============ Hero: avatar, level, XP ============ -->
        <LinearLayout
            android:id="@+id/card_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_header"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="112dp"
                    android:layout_height="112dp">

                    <com.example.liferpg.ui.AvatarView
                        android:id="@+id/avatar_view"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:layout_gravity="center"
                        android:contentDescription="Your avatar. Tap to customize." />

                    <TextView
                        android:id="@+id/tv_level_badge"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="bottom|end"
                        android:autoSizeMaxTextSize="17sp"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeTextType="uniform"
                        android:background="@drawable/bg_level_badge"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:padding="6dp"
                        android:textColor="@color/lr_on_gold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_welcome"
                        style="@style/Text.LifeRPG.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome back"
                        android:textColor="#B3FFFFFF" />

                    <TextView
                        android:id="@+id/tv_greeting"
                        style="@style/Text.LifeRPG.Headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/lr_white" />

                    <TextView
                        android:id="@+id/tv_level_title"
                        style="@style/Text.LifeRPG"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/lr_gold_light"
                        android:textSize="15sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/ib_settings"
                    style="@style/Widget.LifeRPG.IconButton.Glass"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top"
                    android:contentDescription="Settings"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_level"
                    style="@style/Text.LifeRPG.Overline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/lr_gold_light"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_xp_text"
                    style="@style/Text.LifeRPG.OnGradient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="15sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pb_xp"
                style="@style/Widget.LifeRPG.ProgressBar.OnGradient"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="10dp"
                android:max="1000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_total_xp"
                    style="@style/Text.LifeRPG.OnGradient"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:alpha="0.85"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_customize"
                    style="@style/Widget.LifeRPG.Button.Glass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Customize"
                    app:icon="@drawable/ic_sparkle"
                    app:iconSize="18dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ Streak + daily quests ============ -->
        <LinearLayout
            android:id="@+id/row_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LifeRPG.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_gold"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_fire"
                            app:tint="@color/lr_gold_text" />

                        <TextView
                            style="@style/Text.LifeRPG.Overline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Streak" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_streak"
                        style="@style/Text.LifeRPG.Metric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/lr_gold_text"
                        android:textSize="34sp" />

                    <TextView
                        android:id="@+id/tv_best_streak"
                        style="@style/Text.LifeRPG.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LifeRPG.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.LifeRPG.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily quests" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="68dp"
                            android:layout_height="68dp">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/pb_daily"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:max="1000"
                                app:indicatorColor="@color/lr_success"
                                app:indicatorSize="68dp"
                                app:trackColor="@color/lr_surface_high"
                                app:trackCornerRadius="7dp"
                                app:trackThickness="7dp" />

                            <TextView
                                android:id="@+id/tv_daily"
                                style="@style/Text.LifeRPG.Title"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:autoSizeMaxTextSize="17sp"
                                android:autoSizeMinTextSize="10sp"
                                android:autoSizeTextType="uniform"
                                android:gravity="center"
                                android:maxLines="1"
                                android:padding="12dp" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_daily_sub"
                            style="@style/Text.LifeRPG.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ============ Today's quests ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_today"
            style="@style/Widget.LifeRPG.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.LifeRPG.Section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Today's quests" />

                    <TextView
                        android:id="@+id/tv_view_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center_vertical|end"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:paddingHorizontal="8dp"
                        android:text="View all"
                        android:textColor="@color/lr_primary_text"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_today_quests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_today_empty"
                    style="@style/Text.LifeRPG.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Nothing scheduled for today. Add a daily quest or set a due date." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Shortcuts ============ -->
        <LinearLayout
            android:id="@+id/row_shortcuts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quests"
                style="@style/Widget.LifeRPG.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="Quests"
                app:icon="@drawable/ic_quests" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_focus"
                style="@style/Widget.LifeRPG.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:layout_weight="1"
                android:text="Focus"
                app:icon="@drawable/ic_timer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_gym"
                style="@style/Widget.LifeRPG.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:layout_weight="1"
                android:text="Gyms"
                app:icon="@drawable/ic_place" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_workout"
                style="@style/Widget.LifeRPG.Button.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="Workout"
                app:icon="@drawable/ic_gym" />
        </LinearLayout>

        <!-- ============ Overall progress + achievements ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_recent"
            style="@style/Widget.LifeRPG.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Text.LifeRPG.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Overall progress" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_stat_quests"
                            style="@style/Text.LifeRPG.Metric"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="26sp" />

                        <TextView
                            style="@style/Text.LifeRPG.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quests done" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_stat_focus"
                            style="@style/Text.LifeRPG.Metric"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="26sp" />

                        <TextView
                            style="@style/Text.LifeRPG.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Focus sessions" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_stat_workouts"
                            style="@style/Text.LifeRPG.Metric"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="26sp" />

                        <TextView
                            style="@style/Text.LifeRPG.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Workouts" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@drawable/bg_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_trophy"
                        app:tint="@color/lr_gold_text" />

                    <TextView
                        style="@style/Text.LifeRPG.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Achievements" />

                    <TextView
                        android:id="@+id/tv_ach_count"
                        style="@style/Text.LifeRPG.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_ach"
                    style="@style/Widget.LifeRPG.ProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:max="1000" />

                <LinearLayout
                    android:id="@+id/ll_recent_ach"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_no_ach"
                    style="@style/Text.LifeRPG.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="No badges yet. Complete a quest to earn your first one!" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Character stats ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_attributes"
            style="@style/Widget.LifeRPG.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Text.LifeRPG.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Character stats" />

                <LinearLayout
                    android:id="@+id/ll_attributes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
